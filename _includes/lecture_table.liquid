{% comment %}
  Renders the lecture schedule table for one offering.

  Usage: {% include lecture_table.liquid year="2025" %}

  Reads _data/lectures/<year>.yml. `slides` is either a single entry or a list
  of entries, so one week can carry several decks. Each entry is a file name
  or URL, or a mapping with `file:` and an optional `label:`. File names are
  resolved against assets/pdf/<year>/; values containing "://" are linked
  as-is so past years can point at externally hosted decks.
{% endcomment %}

{% assign lectures = site.data.lectures[include.year] %}

{% if lectures %}
  <table>
    <thead>
      <tr>
        <th>Lecture</th>
        <th>Date</th>
        <th>Topics</th>
        <th>Materials</th>
      </tr>
    </thead>
    <tbody>
      {% for lecture in lectures %}
        <tr>
          <td>{{ forloop.index }}</td>
          <td>
            {%- if lecture.date -%}
              {{ lecture.date }}
            {%- else -%}
              TBD
            {%- endif -%}
          </td>
          <td>{{ lecture.title }}</td>
          <td>
            {%- if lecture.slides and lecture.slides != empty -%}
              {%- assign slides_json_head = lecture.slides | jsonify | slice: 0 -%}
              {%- if slides_json_head == '[' -%}
                {%- assign slide_list = lecture.slides -%}
              {%- else -%}
                {%- assign slide_list = '' | split: '' | push: lecture.slides -%}
              {%- endif -%}
              {%- for slide in slide_list -%}
                {%- assign slide_file = slide.file | default: slide -%}
                {%- if slide_file contains '://' -%}
                  {%- assign slide_path = slide_file -%}
                {%- else -%}
                  {%- capture slide_asset %}assets/pdf/{{ include.year }}/{{ slide_file }}{% endcapture -%}
                  {%- assign slide_path = slide_asset | relative_url -%}
                {%- endif -%}
                {%- if slide.label -%}
                  {%- assign slide_label = slide.label -%}
                {%- elsif slide_list.size > 1 -%}
                  {%- capture slide_label %}slides {{ forloop.index }}{% endcapture -%}
                {%- else -%}
                  {%- assign slide_label = 'slides' -%}
                {%- endif -%}
                {%- unless forloop.first %}<br>{% endunless -%}
                <a href="{{ slide_path }}">{{ slide_label }}</a>
              {%- endfor -%}
            {%- else -%}
              TBD
            {%- endif -%}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endif %}
